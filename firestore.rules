rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function role() {
      return signedIn() ? userDoc().data.get("rol", "") : "";
    }

    function isAdmin() {
      return signedIn() && role() == "admin";
    }

    function isSupervisor() {
      return signedIn() && (role() == "admin" || role() == "supervisor");
    }

    function isActiveUser() {
      return signedIn() && (userDoc().data.get("activo", false) == true || userDoc().data.get("activo", false) == "true");
    }

    function hasValidAutomaticDeliveryFee() {
      return request.resource.data.valorDomicilio in [10000, 15000]
             && request.resource.data.valorDomicilioCongelado == request.resource.data.valorDomicilio
             && request.resource.data.tarifaBase == request.resource.data.valorDomicilio
             && request.resource.data.tipoTarifa in ["rango_10000", "rango_15000"];
    }

    function changesDeliveryFee() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "valorDomicilio", "valorDomicilioCongelado", "tarifaBase", "tipoTarifa",
        "tarifaMotivo", "modificadoPor", "modificadoPorNombre", "modificadoEn"
      ]);
    }

    match /usuarios/{userId} {
      allow get: if isActiveUser() && (request.auth.uid == userId || isSupervisor());
      allow list: if isActiveUser() && isSupervisor();
      allow create: if isAdmin();
      allow update: if isAdmin()
                    || (
                      isActiveUser()
                      && request.auth.uid == userId
                      && request.resource.data.rol == resource.data.rol
                      && request.resource.data.activo == resource.data.activo
                    );
      allow delete: if isAdmin();
    }

    match /turnos/{turnoId} {
      allow get: if isActiveUser()
                 && (isSupervisor() || resource.data.usuarioId == request.auth.uid);
      allow list: if isActiveUser() && (isSupervisor() || resource.data.usuarioId == request.auth.uid);
      allow create: if isActiveUser()
                    && request.resource.data.usuarioId == request.auth.uid
                    && request.resource.data.estado == "activo";
      allow update: if isActiveUser()
                    && (
                      isSupervisor()
                      || (
                        resource.data.usuarioId == request.auth.uid
                        && request.resource.data.usuarioId == resource.data.usuarioId
                        && request.resource.data.estado in ["activo", "cerrado"]
                      )
                    );
      allow delete: if isAdmin();
    }

    match /entregas/{entregaId} {
      allow get: if isActiveUser()
                 && (isSupervisor() || resource.data.usuarioId == request.auth.uid);
      allow list: if isActiveUser() && (isSupervisor() || resource.data.usuarioId == request.auth.uid);

      // El domiciliario solo crea registros propios y con tarifa automática válida.
      // El administrador puede crear registros históricos manuales o importados;
      // estos conservan el valor de domicilio congelado para Nómina.
      allow create: if isActiveUser()
                    && (
                      isAdmin()
                      || (
                        request.resource.data.usuarioId == request.auth.uid
                        && request.resource.data.creadoPor == request.auth.uid
                        && request.resource.data.usuarioEmail == request.auth.token.email
                        && hasValidAutomaticDeliveryFee()
                      )
                    );

      allow update: if isActiveUser()
                    && (
                      (isSupervisor() && (!changesDeliveryFee() || isAdmin()))
                      || (
                        resource.data.usuarioId == request.auth.uid
                        && request.resource.data.usuarioId == resource.data.usuarioId
                        && request.resource.data.creadoPor == resource.data.creadoPor
                        && !changesDeliveryFee()
                      )
                    );
      allow delete: if isAdmin();
    }

    match /tracking_actual/{userId} {
      allow get: if isActiveUser() && (request.auth.uid == userId || isSupervisor());
      allow list: if isActiveUser() && isSupervisor();
      allow create, update: if isActiveUser()
                            && request.auth.uid == userId
                            && request.resource.data.usuarioId == userId;
      allow delete: if isAdmin();
    }

    match /tracking_historial/{documentId} {
      allow read: if isActiveUser() && isSupervisor();
      allow create: if isActiveUser()
                    && request.resource.data.usuarioId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /auditoria/{auditId} {
      allow read: if isActiveUser() && isAdmin();
      allow create: if isActiveUser() && isSupervisor();
      allow update, delete: if isAdmin();
    }

    match /configuracion/{configId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
